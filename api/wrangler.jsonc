// El Worker de Fragmentless (libreta 3, Seguridad). Arriba, el de verdad, «api», que se
// publica desde GitHub cuando existan los dominios (con su ruta api.fragmentless.com). Abajo,
// en env.pruebas, su copia «api-pruebas», que recibe primero cada cambio y se prueba con el
// Restaurante de prueba: npm run publicar-pruebas.
// En wrangler las vars y los bindings no se heredan: cada uno lleva los suyos.
// Aquí no hay ningún secreto: la URL de Supabase y su llave publicable son las mismas que ya
// van dentro de la app. Las llaves secretas se pegan en el dashboard de Cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "SUPABASE_URL": "https://jntciroxrgxqyhtdtxhw.supabase.co",
    "SUPABASE_LLAVE_PUBLICABLE": "sb_publishable__z6hdwI-FsCuiVGtdySVOw_7BCCZFCG",
    "ORIGENES": "https://app.fragmentless.com,https://pidemenu.mx"
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "fragmentless" }],
  // El trabajo en segundo plano que hace cada anuncio (src/hacerAnuncio.ts).
  "workflows": [{ "name": "hacer-anuncio", "binding": "HACER_ANUNCIO", "class_name": "HacerAnuncio" }],
  // El borrado de los 30 días de Mi biblioteca (src/biblioteca.ts): cada día a las 9:00 UTC, las 3:00
  // en la Ciudad de México, cuando en todo México ya cambió el día.
  "triggers": { "crons": ["0 9 * * *"] },
  "env": {
    "pruebas": {
      "name": "api-pruebas",
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true },
      "vars": {
        "SUPABASE_URL": "https://jntciroxrgxqyhtdtxhw.supabase.co",
        "SUPABASE_LLAVE_PUBLICABLE": "sb_publishable__z6hdwI-FsCuiVGtdySVOw_7BCCZFCG",
        "ORIGENES": "http://localhost:8125,http://gerente.localhost:8125,http://aparato.localhost:8125,http://fragmentless.localhost:8125,http://localhost:8126"
      },
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "fragmentless" }],
      "workflows": [{ "name": "hacer-anuncio-pruebas", "binding": "HACER_ANUNCIO", "class_name": "HacerAnuncio" }],
      // El mismo borrado, contra la misma base y el mismo bucket: si corren los dos, el segundo ya no
      // encuentra nada.
      "triggers": { "crons": ["0 9 * * *"] }
    }
  }
}
